{
  "functions": { "api/sample.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/funnel", "destination": "https://analitika-five.vercel.app/funnel" },
    { "source": "/funnel/:path*", "destination": "https://analitika-five.vercel.app/funnel/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
