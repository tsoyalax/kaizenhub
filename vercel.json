{
  "functions": {
    "api/sample.js": {
      "maxDuration": 60
    },
    "api/telegram.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/funnel",
      "destination": "https://analitika-five.vercel.app/funnel"
    },
    {
      "source": "/funnel/:path*",
      "destination": "https://analitika-five.vercel.app/funnel/:path*"
    },
    {
      "source": "/igor",
      "destination": "/index.html"
    },
    {
      "source": "/igor/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/telegram?digest=1",
      "schedule": "0 17 * * *"
    }
  ]
}
